<div class="h-[100dvh] flex flex-col md:flex-row font-sans w-[100dvw] bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100 overflow-hidden">
  <section class="flex-1 flex flex-col items-center justify-center p-8 overflow-y-auto">
    <div class="w-full max-w-md">
      {{outlet}}
      <div class="mt-8 flex justify-center">
         <TransitopsAttribution />
      </div>
    </div>
  </section>
  <section class="hidden md:block flex-1 relative p-4">
    <div class="animate-slide-right animate-delay-300 absolute inset-4 rounded-3xl bg-cover bg-center shadow-2xl" style="background-image: url('https://images.unsplash.com/photo-1642615835477-d303d7dc9ee9?w=2160&q=80')"></div>
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex gap-4 px-8 w-full justify-center">
      <div class="animate-testimonial animate-delay-1000 flex items-start gap-3 rounded-3xl bg-black/50 backdrop-blur-md border border-white/20 p-5 w-64 text-white shadow-xl">
        <img src="https://randomuser.me/api/portraits/women/57.jpg" class="h-10 w-10 object-cover rounded-2xl" alt="avatar" />
        <div class="text-sm leading-snug">
          <p class="flex items-center gap-1 font-medium">Sarah Chen</p>
          <p class="text-gray-300">@sarahdigital</p>
          <p class="mt-1 text-gray-200">Amazing platform! The user experience is seamless and the features are exactly what I needed.</p>
        </div>
      </div>
      <div class="hidden xl:flex animate-testimonial animate-delay-1200 items-start gap-3 rounded-3xl bg-black/50 backdrop-blur-md border border-white/20 p-5 w-64 text-white shadow-xl">
        <img src="https://randomuser.me/api/portraits/men/64.jpg" class="h-10 w-10 object-cover rounded-2xl" alt="avatar" />
        <div class="text-sm leading-snug">
          <p class="flex items-center gap-1 font-medium">Marcus Johnson</p>
          <p class="text-gray-300">@marcustech</p>
          <p class="mt-1 text-gray-200">This service has transformed how I work. Clean design, powerful features, and excellent support.</p>
        </div>
      </div>
    </div>
  </section>
</div>