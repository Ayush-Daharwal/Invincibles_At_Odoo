#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/pineapple/Desktop/transitops/new/console/node_modules/.pnpm/ember-source-channel-url@3.0.0/node_modules/ember-source-channel-url/node_modules:/home/pineapple/Desktop/transitops/new/console/node_modules/.pnpm/ember-source-channel-url@3.0.0/node_modules:/home/pineapple/Desktop/transitops/new/console/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/pineapple/Desktop/transitops/new/console/node_modules/.pnpm/ember-source-channel-url@3.0.0/node_modules/ember-source-channel-url/node_modules:/home/pineapple/Desktop/transitops/new/console/node_modules/.pnpm/ember-source-channel-url@3.0.0/node_modules:/home/pineapple/Desktop/transitops/new/console/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../ember-source-channel-url/bin/ember-source-channel-url" "$@"
else
  exec node  "$basedir/../ember-source-channel-url/bin/ember-source-channel-url" "$@"
fi
