<Modal::Default @modalIsOpened={{@modalIsOpened}} @options={{@options}} @confirm={{@onConfirm}} @decline={{@onDecline}}>
    <div class="modal-body-container">
        <p class="text-sm mb-4 text-gray-900 dark:text-gray-200">
            Begin the installation from the base directory of your Transitops instance. For comprehensive instructions, visit the
            <a href="https://github.com/transitops/transitops-cli" target="transitops-cli" class="text-blue-400 hover:opacity-50">
                <FaIcon @icon="arrow-up-right-from-square" class="text-xs" />
                Transitops CLI GitHub page</a>.
        </p>
        <ol class="self-managed-install-instructions">
            <li>
                <div class="flex">
                    First,
                    <LinkTo @route="console.extensions.developers.credentials" class="ml-1 text-blue-400 hover:opacity-50">generate a Transitops registry credentials token.</LinkTo>
                </div>
            </li>
            <li>
                <div class="flex flex-col">
                    <div class="mb-2">Install the Transitops CLI globally using npm:</div>
                    <ClickToCopy @value={{concat "npm i -g @transitops/cli"}}><code>npm i -g @transitops/cli</code></ClickToCopy>
                </div>
            </li>
            <li>
                <div class="flex flex-col">
                    <div class="mb-2">Set your authentication token with the CLI:</div>
                    <ClickToCopy @value={{concat "tro set-auth {YOUR_TOKEN}"}}><code>tro set-auth {YOUR_TOKEN}</code></ClickToCopy>
                </div>
            </li>
            <li>
                <div class="flex flex-col">
                    <div class="mb-2">Finally, install the extension using one of the following commands:</div>
                    <div>
                        <ClickToCopy @value={{concat "tro install transitops/" @options.extension.slug}}><code>tro install transitops/{{@options.extension.slug}}</code></ClickToCopy>
                        <div class="my-1 pl-2">or</div>
                        <ClickToCopy @value={{concat "tro install " @options.extension.public_id}}><code>tro install {{@options.extension.public_id}}</code></ClickToCopy>
                    </div>
                </div>
            </li>
        </ol>
    </div>
</Modal::Default>